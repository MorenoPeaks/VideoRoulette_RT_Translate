# ──────────────────────────────────────────────────────────────
# Server (apps/server)
# ──────────────────────────────────────────────────────────────

# OpenAI API key with access to gpt-realtime-translate
OPENAI_API_KEY=sk-...

# Text model used to translate chat messages (cheap text model)
CHAT_TRANSLATION_MODEL=gpt-4o-mini

# LiveKit credentials.
# Option A — LiveKit Cloud (https://cloud.livekit.io): copy from your project.
# Option B — local dev via `docker compose up`: use the values below as-is.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_32

# Port for the matchmaking/API server
PORT=4000

# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Web app (apps/web) — create apps/web/.env.local with:
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
